# 阿里云百炼 API Key（也可用 macOS 钥匙串 + start.sh 注入）
DASHSCOPE_API_KEY=sk-your-key

# 可选：覆盖默认 VL 模型（默认 qwen3-vl-flash）
# VISION_MCP_MODEL=qwen3-vl-flash

# 可选：允许读取的本地目录，冒号分隔（默认可访问 $HOME 下路径）
# VISION_MCP_ALLOWED_DIRS=/path/to/pictures:/path/to/downloads

# 可选：DashScope OpenAI 兼容 base_url（默认北京）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
