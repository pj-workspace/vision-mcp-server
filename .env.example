# --- Kimi Coding Plan（会员 Key，sk-kimi-...；视觉走 OpenAI 兼容端点）---
VISION_MCP_PROVIDER=moonshot
MOONSHOT_API_KEY=sk-your-kimi-coding-api-key
VISION_MCP_MODEL=kimi-for-coding
MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1

# --- Kimi 开放平台（按量付费，非 Coding Plan）---
# VISION_MCP_PROVIDER=moonshot
# MOONSHOT_API_KEY=sk-your-moonshot-open-platform-key
# VISION_MCP_MODEL=moonshot-v1-8k-vision-preview
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 也可用通用变量名（优先级：VISION_MCP_API_KEY > MOONSHOT_API_KEY）
# VISION_MCP_API_KEY=sk-your-key

# --- 阿里云百炼 DashScope（原默认）---
# VISION_MCP_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# VISION_MCP_MODEL=qwen3-vl-flash
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：允许读取的本地目录，冒号分隔（默认可访问 $HOME 下路径）
# VISION_MCP_ALLOWED_DIRS=/path/to/pictures:/path/to/downloads
